# n8n webhook URL — the POST endpoint that triggers video generation
N8N_WEBHOOK_URL=

# n8n status base URL — used to poll job status (e.g. https://your-n8n.app.n8n.cloud/webhook/status)
# Only needed if your workflow returns a jobId instead of an immediate videoUrl
N8N_STATUS_BASE_URL=

# Your deployed app URL — used if you implement webhook callbacks from n8n
NEXT_PUBLIC_APP_URL=
